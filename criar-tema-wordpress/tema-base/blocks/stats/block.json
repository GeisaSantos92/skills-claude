{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "starter/stats",
	"title": "Seção: Faixa de estatísticas",
	"category": "starter-secoes",
	"icon": "chart-bar",
	"description": "Faixa com badge, título e grade de indicadores (número + rótulo). Exemplo do padrão pai/filho com InnerBlocks.",
	"textdomain": "started-theme",
	"attributes": {
		"badge": { "type": "string", "default": "" },
		"titulo": { "type": "string", "default": "" }
	},
	"supports": { "html": false, "customClassName": false },
	"editorScript": "starter-block-stats",
	"render": "file:./render.php"
}
